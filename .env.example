# Local demo defaults. Never commit your real .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=aiims_connect
DB_CONNECT_TIMEOUT=8
FLASK_DEBUG=1
COOKIE_SECURE=0
